{
  "name": "jupiter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && npm run build:appointment-jobs",
    "build:appointment-jobs": "vite build --config vite.jobs.config.ts",
    "db:constraints": "node --experimental-strip-types scripts/schema-integrity.ts --apply",
    "db:format": "prisma format",
    "db:gen": "prisma generate",
    "db:generate": "prisma generate",
    "db:mig": "prisma migrate dev",
    "db:mig:deploy": "prisma migrate deploy",
    "db:mig:reset": "prisma migrate reset",
    "db:mig:status": "prisma migrate status",
    "db:preflight": "node --experimental-strip-types scripts/schema-integrity.ts",
    "db:pull": "prisma db pull",
    "db:push": "npm run db:generate && npm run db:preflight && prisma db push && npm run db:constraints",
    "db:reset": "prisma db push --force-reset",
    "db:seed:barber": "node --experimental-strip-types scripts/seed-barber.ts",
    "db:studio": "prisma studio",
    "db:val": "prisma validate",
    "dev": "react-router dev --host --port 5175",
    "icons:generate": "node --experimental-strip-types scripts/generate-icons.ts",
    "jobs:appointments": "node --env-file-if-exists=.env build/jobs/runner.js",
    "mockups:generate": "node --experimental-strip-types scripts/generate-mockups.ts",
    "start": "node --env-file-if-exists=.env ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "test:appointment-settings": "node --experimental-strip-types tests/organization-settings.integration.ts",
    "test:appointments": "node --experimental-strip-types tests/appointment-availability.test.ts && node --experimental-strip-types tests/appointments.integration.ts",
    "test:barber-seed": "node --experimental-strip-types tests/barber-seed.test.ts",
    "test:barber-seed:integration": "node --experimental-strip-types tests/barber-seed.integration.ts",
    "test:communications": "node --experimental-strip-types tests/email-templates.test.ts && node --experimental-strip-types tests/communications.integration.ts && node --experimental-strip-types tests/email-locale.integration.ts",
    "test:permissions": "node --experimental-strip-types tests/role-permissions.integration.ts",
    "test:resource-limits": "node --experimental-strip-types tests/resource-limits.integration.ts",
    "test:settings": "node --experimental-strip-types tests/settings-navigation.integration.ts",
    "test:team": "node --experimental-strip-types tests/team.integration.ts",
    "test:team-people": "node --experimental-strip-types tests/team-people.integration.ts && node --experimental-strip-types tests/team-people-ssr.integration.ts",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "@base-ui/react": "latest",
    "@better-auth/i18n": "latest",
    "@better-auth/prisma-adapter": "latest",
    "@better-auth/stripe": "latest",
    "@dnd-kit/abstract": "latest",
    "@dnd-kit/dom": "latest",
    "@dnd-kit/react": "latest",
    "@js-temporal/polyfill": "latest",
    "@kitlangton/rolling-number": "latest",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "@react-router/node": "latest",
    "@react-router/serve": "latest",
    "@rvf/react": "latest",
    "@semihbou/zod-i18n-map": "latest",
    "@tabler/icons-react": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-table": "latest",
    "@trpc/client": "latest",
    "@trpc/server": "latest",
    "@trpc/tanstack-react-query": "latest",
    "better-auth": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "i18next": "latest",
    "isbot": "latest",
    "lucide-react": "latest",
    "nanoid": "latest",
    "pg": "latest",
    "qrcode.react": "latest",
    "react": "latest",
    "react-day-picker": "latest",
    "react-dom": "latest",
    "react-email": "latest",
    "react-i18next": "latest",
    "react-router": "latest",
    "remix-i18next": "latest",
    "resend": "latest",
    "sharp": "latest",
    "stripe": "latest",
    "superjson": "latest",
    "tailwind-merge": "latest",
    "ts-deepmerge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@react-router/dev": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "dotenv": "latest",
    "prisma": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "overrides": {
    "find-my-way": "latest",
    "valibot": "latest"
  }
}
