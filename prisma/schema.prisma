generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  PUBLIC_BOOKING
  ADMIN
  STAFF
  API
  IMPORT
}

enum AttendanceStatus {
  BOOKED
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum ServiceDeliveryType {
  IN_PERSON
  ONLINE
  PHONE
  FLEXIBLE
}

enum PaymentRequirement {
  NONE
  OPTIONAL
  FULL
  DEPOSIT
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum NotificationKind {
  BOOKING_CONFIRMATION
  REMINDER
  CANCELLATION
  RESCHEDULE
  FOLLOW_UP
  WAITLIST_OFFER
  CUSTOM
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  NUMBER
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
  DATE
  DATETIME
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  EXPIRED
  CANCELLED
}

enum ResourceType {
  ROOM
  EQUIPMENT
  OTHER
}

enum IntegrationType {
  CALENDAR
  VIDEO_CONFERENCING
  PAYMENT
  CRM
  OTHER
}

enum AppointmentEventType {
  CREATED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  CHECKED_IN
  STARTED
  COMPLETED
  NO_SHOW
  NOTE_ADDED
  PAYMENT_UPDATED
  REMINDER_SENT
}

model User {
  id               String       @id @default(nanoid())
  name             String
  email            String
  emailVerified    Boolean      @default(false)
  image            String?
  locale           String?
  stripeCustomerId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]

  @@unique([email])
  @@map("user")
}

model Note {
  id             String       @id @default(nanoid())
  title          String
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("note")
}

model Session {
  id                   String   @id @default(nanoid())
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(nanoid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(nanoid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id               String                @id @default(nanoid())
  name             String
  slug             String
  logo             String?
  createdAt        DateTime
  metadata         String?
  stripeCustomerId String?
  members          Member[]
  invitations      Invitation[]
  notes            Note[]
  settings         OrganizationSettings?

  locations             Location[]
  serviceCategories     ServiceCategory[]
  services              Service[]
  staffMembers          StaffMember[]
  customers             Customer[]
  customerNotes         CustomerNote[]
  customerTags          CustomerTag[]
  availabilityRules     AvailabilityRule[]
  availabilityOverrides AvailabilityOverride[]
  blockedTimes          BlockedTime[]
  appointments          Appointment[]
  appointmentSeries     AppointmentSeries[]
  appointmentEvents     AppointmentEvent[]
  payments              Payment[]
  refunds               Refund[]
  notificationTemplates NotificationTemplate[]
  notifications         Notification[]
  bookingQuestions      BookingQuestion[]
  integrations          Integration[]
  resources             Resource[]
  waitlistEntries       WaitlistEntry[]
  bookingPages          BookingPage[]
  webhookEndpoints      WebhookEndpoint[]
  auditLogs             AuditLog[]

  @@unique([slug])
  @@map("organization")
}

model Subscription {
  id                   String    @id @default(nanoid())
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@index([referenceId])
  @@index([stripeCustomerId])
  @@map("subscription")
}

model Member {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  staffProfile StaffMember?

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  inviteeName    String?
  staffMemberId  String?
  staffMember    StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model OrganizationSettings {
  id             String       @id @default(nanoid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessId     String?
  timezone       String       @default("Europe/Helsinki")
  location       String       @default("FI")
  currency       String       @default("EUR")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bookingEnabled              Boolean @default(true)
  allowSimultaneousBookings   Boolean @default(false)
  weekStartsOn                Int     @default(1)
  defaultSlotIntervalMinutes  Int     @default(15)
  minBookingNoticeMinutes     Int     @default(0)
  maxBookingAdvanceDays       Int?
  cancellationNoticeMinutes   Int     @default(0)
  rescheduleNoticeMinutes     Int     @default(0)
  requireCustomerEmail        Boolean @default(true)
  requireCustomerPhone        Boolean @default(false)
  allowCustomerCancellation   Boolean @default(true)
  allowCustomerRescheduling   Boolean @default(true)
  autoConfirmAppointments     Boolean @default(true)
  sendBookingConfirmations    Boolean @default(true)
  sendCancellationEmails      Boolean @default(true)
  sendRescheduleEmails        Boolean @default(true)

  defaultLocationId String?
  defaultLocation Location? @relation("OrganizationDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)
  defaultTimezone String?
  defaultBookingPageId String?
  defaultBookingPage BookingPage? @relation("OrganizationDefaultBookingPage", fields: [defaultBookingPageId], references: [id], onDelete: SetNull)

  defaultCalendarView String @default("week")
  defaultStartHour Int @default(8)
  defaultEndHour Int @default(18)
  showWeekends Boolean @default(true)
  showCancelledAppointments Boolean @default(true)
  calendarSlotIntervalMinutes Int @default(30)

  enableAppointmentReminders Boolean @default(true)
  reminderOffsetsMinutes Int[] @default([1440])
  senderName String?
  replyToAddress String?


  @@map("organization_settings")
}

model Location {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  phone String?
  email String?

  timezone String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  bookingInstructions String?
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffLocations        StaffLocation[]
  serviceLocations      ServiceLocation[]
  availabilityRules     AvailabilityRule[]
  availabilityOverrides AvailabilityOverride[]
  blockedTimes          BlockedTime[]
  appointments          Appointment[]
  resources             Resource[]
  waitlistEntries       WaitlistEntry[]

  defaultBookingPages BookingPage[] @relation("BookingPageDefaultLocation")
  defaultForOrganizations OrganizationSettings[] @relation("OrganizationDefaultLocation")

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("location")
}

model ServiceCategory {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@index([organizationId, sortOrder])
  @@map("service_category")
}

  model Service {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name        String
  slug        String
  description String?

  durationMinutes     Int
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(0)

  price    Decimal? @db.Decimal(12, 2)
  currency String  @default("EUR")

  deliveryType ServiceDeliveryType @default(IN_PERSON)

  paymentRequirement PaymentRequirement @default(NONE)
  depositAmount      Decimal?           @db.Decimal(12, 2)

  maxAttendees Int @default(1)

  minBookingNoticeMinutes   Int @default(0)
  maxBookingAdvanceDays     Int?
  cancellationNoticeMinutes Int?
  rescheduleNoticeMinutes   Int?

  requiresConfirmation Boolean @default(false)
  allowWaitlist        Boolean @default(false)
  isActive             Boolean @default(true)

  color String?
  image String?

  sortOrder Int @default(0)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffServices        StaffService[]
  serviceLocations     ServiceLocation[]
  appointmentServices  AppointmentService[]
  bookingQuestions     BookingQuestion[]
  waitlistEntries      WaitlistEntry[]
  bookingPageServices  BookingPageService[]
  resourceRequirements ServiceResource[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@index([organizationId, deletedAt])
  @@index([categoryId])
  @@map("service")
}

model StaffMember {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberId String? @unique
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  name  String
  email String?
  phone String?
  image String?
  bio   String?

  timezone String?

  isActive          Boolean @default(true)
  acceptsAppointments Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitations           Invitation[]
  staffServices         StaffService[]
  staffLocations        StaffLocation[]
  availabilityRules     AvailabilityRule[]
  availabilityOverrides AvailabilityOverride[]
  blockedTimes          BlockedTime[]
  appointments          Appointment[]
  appointmentServices   AppointmentService[]
  externalCalendars     ExternalCalendar[]
  waitlistEntries       WaitlistEntry[]
  bookingPageStaff      BookingPageStaff[]

  @@unique([organizationId, email])
  @@index([organizationId, isActive])
  @@map("staff_member")
}

model StaffService {
  id String @id @default(nanoid())

  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  durationMinutes Int?
  price           Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffMemberId, serviceId])
  @@index([serviceId])
  @@map("staff_service")
}

model StaffLocation {
  id String @id @default(nanoid())

  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([staffMemberId, locationId])
  @@index([locationId])
  @@map("staff_location")
}

model ServiceLocation {
  id String @id @default(nanoid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([serviceId, locationId])
  @@index([locationId])
  @@map("service_location")
}

model Customer {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  email     String?
  phone     String?

  timezone String?
  locale   String?

  dateOfBirth DateTime?

  company String?
  jobTitle String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  marketingConsent Boolean @default(false)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  attendees    AppointmentAttendee[]
  notes        CustomerNote[]
  tags         CustomerTagAssignment[]
  waitlist     WaitlistEntry[]
  payments     Payment[]

  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, firstName, lastName])
  @@map("customer")
}

model CustomerNote {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  body String

  authorUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId, createdAt])
  @@map("customer_note")
}

model CustomerTag {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  color String?

  createdAt DateTime @default(now())

  assignments CustomerTagAssignment[]

  @@unique([organizationId, name])
  @@map("customer_tag")
}

model CustomerTagAssignment {
  id String @id @default(nanoid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  tagId String
  tag   CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, tagId])
  @@index([tagId])
  @@map("customer_tag_assignment")
}

/// Weekly recurring availability.
///
/// dayOfWeek should use 0-6 where:
/// 0 = Sunday
/// 1 = Monday
/// ...
/// 6 = Saturday
///
/// startMinute/endMinute are minutes from local midnight.
/// Example: 09:30 = 570.
model AvailabilityRule {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  staffMemberId String?
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  dayOfWeek  Int
  startMinute Int
  endMinute   Int

  timezone String

  validFrom  DateTime?
  validUntil DateTime?

  isActive Boolean @default(true)
  isBreak Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, dayOfWeek])
  @@index([staffMemberId, dayOfWeek])
  @@index([locationId, dayOfWeek])
  @@map("availability_rule")
}

/// One-off availability changes.
///
/// Use `isAvailable = false` for holidays, closures or time off.
/// Use `isAvailable = true` for extra availability outside normal hours.
model AvailabilityOverride {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  staffMemberId String?
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime

  isAvailable Boolean @default(false)
  reason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startsAt, endsAt])
  @@index([staffMemberId, startsAt, endsAt])
  @@index([locationId, startsAt, endsAt])
  @@map("availability_override")
}

model BlockedTime {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  staffMemberId String?
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime

  title  String?
  reason String?
  recurrence Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startsAt, endsAt])
  @@index([staffMemberId, startsAt, endsAt])
  @@index([locationId, startsAt, endsAt])
  @@map("blocked_time")
}

model AppointmentSeries {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String?

  /// RFC 5545 RRULE, e.g. FREQ=WEEKLY;INTERVAL=1
  recurrenceRule String

  timezone String

  startsAt DateTime
  endsAt   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([organizationId, isActive])
  @@map("appointment_series")
}

model Appointment {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bookingCode String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  staffMemberId String?
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  seriesId String?
  series   AppointmentSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  rescheduledFromId String?
  rescheduledFrom   Appointment?  @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Appointment[] @relation("AppointmentReschedule")

  status AppointmentStatus @default(PENDING)
  source AppointmentSource @default(PUBLIC_BOOKING)

  startsAt DateTime
  endsAt   DateTime
  timezone String

  customerNotes String?
  internalNotes String?

  meetingUrl String?

  cancellationReason String?
  cancelledAt        DateTime?
  confirmedAt        DateTime?
  checkedInAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?

  expiresAt DateTime?

  currency String @default("EUR")

  subtotalAmount Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services          AppointmentService[]
  attendees         AppointmentAttendee[]
  resources         AppointmentResource[]
  answers           BookingAnswer[]
  payments          Payment[]
  notifications     Notification[]
  events            AppointmentEvent[]
  externalEvents    ExternalCalendarEvent[]

  @@index([organizationId, startsAt])
  @@index([organizationId, status, startsAt])
  @@index([staffMemberId, startsAt, endsAt])
  @@index([locationId, startsAt, endsAt])
  @@index([customerId, startsAt])
  @@index([seriesId])
  @@index([rescheduledFromId])
  @@map("appointment")
}

model AppointmentService {
  id String @id @default(nanoid())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  staffMemberId String?
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)

  /// Snapshot fields preserve historical appointment information
  /// if the underlying service later changes.
  name            String
  durationMinutes Int

  quantity Int @default(1)

  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  totalPrice Decimal @default(0) @db.Decimal(12, 2)

  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(0)

  createdAt DateTime @default(now())

  @@index([appointmentId])
  @@index([serviceId])
  @@index([staffMemberId])
  @@map("appointment_service")
}

model AppointmentAttendee {
  id String @id @default(nanoid())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  name  String
  email String?
  phone String?

  status AttendanceStatus @default(BOOKED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([customerId])
  @@map("appointment_attendee")
}

model AppointmentEvent {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  type AppointmentEventType

  actorUserId String?

  message  String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([appointmentId, createdAt])
  @@index([organizationId, createdAt])
  @@map("appointment_event")
}

model Resource {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  name        String
  description String?

  type ResourceType @default(OTHER)

  capacity Int @default(1)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequirements ServiceResource[]
  appointments        AppointmentResource[]

  @@index([organizationId, isActive])
  @@index([locationId])
  @@map("resource")
}

model ServiceResource {
  id String @id @default(nanoid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())

  @@unique([serviceId, resourceId])
