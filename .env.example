DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5175
# Optional comma-separated additional hosts allowed by Better Auth.
BETTER_AUTH_ALLOWED_HOSTS=
VITE_URL=http://localhost:5175
# Layout: floating or classic. Defaults to classic when unset.
VITE_APP_LAYOUT_STYLE=floating
# Vertically center page content on desktop. Set false to align pages at the top.
VITE_APP_CENTER_CONTENT=false

# Optional IP geolocation defaults for onboarding.
LOCATION_API=
LOCATION_API_URL=https://locara.humade.studio/p/v1/location

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
# Supported values: plunk or resend. Leave blank to disable delivery.
EMAIL_PROVIDER=
PLUNK_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Pluto <noreply@example.com>
# Optional testing override. Supports one address or comma-separated addresses.
EMAIL_OVERRIDE_TO=
