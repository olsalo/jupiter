# Required app settings
# PostgreSQL connection string
DATABASE_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Full app URL, including http:// or https://; use your public URL in production
BETTER_AUTH_URL=http://localhost:5175

# Optional auth settings
# Optional comma-separated additional hosts allowed by Better Auth.
BETTER_AUTH_ALLOWED_HOSTS=

# Optional appearance settings
# floating or classic; defaults to classic when unset; applied at build time
APP_LAYOUT_STYLE=floating

# Email: required for production sign-in and email delivery, optional locally
# plunk or resend; leave blank locally to print sign-in codes in the server console
EMAIL_PROVIDER=
# Set only the API key for your chosen provider
PLUNK_API_KEY=
RESEND_API_KEY=
# Required when sending email; use an address verified with your provider
EMAIL_FROM=Example <noreply@example.com>
# Optional testing override for all email recipients; one address or comma-separated addresses
EMAIL_OVERRIDE_TO=

# Optional IP geolocation API
# Set the key to enable lookups; leave blank to disable them
LOCATION_API_KEY=123
# Optional endpoint override; the URL below is also the built-in default
LOCATION_API_URL=https://locara.humade.studio/p/v1/location

# Optional Stripe billing
# Set all three settings below to enable billing; leave all blank to disable it
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Optional annual price; only needed to offer annual billing
STRIPE_PRO_ANNUAL_PRICE_ID=

# Optional local demo setting
# Set true to skip Stripe checkout after starting a trial during onboarding demos
DEMO_BYPASS_ONBOARDING_PAYMENT=true

# Optional mockup generation settings; only used by npm run mockups:generate
# Uncomment to override the script defaults: http://localhost:3000/api/mockup and token 123
# MOCKUP_API_URL=http://localhost:3000/api/mockup
# MOCKUP_API_TOKEN=

# Optional booking rate-limit setting
# Only set when the reverse proxy strips incoming client values for this header
BOOKING_TRUSTED_IP_HEADER=x-forwarded-for
